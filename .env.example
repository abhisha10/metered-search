APP_NAME="Autocomplete Billing Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=autocomplete
DB_USERNAME=postgres
DB_PASSWORD=secret

CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SEARCH_LIMIT=8
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_SIMILARITY_THRESHOLD=0.25
SEARCH_STATEMENT_TIMEOUT_MS=45
SEARCH_CACHE_TTL=60

DEMO_API_KEY=demo-key-change-me
